{
  "frontend": {
    "name": "ES-DE",
    "why": "It launches each system's emulator from one list of every game, and reads the drive's roms folders as they are named.",
    "settings": "~/ES-DE",
    "apps": [
      "ES-DE.app"
    ],
    "config": "settings/es_settings.xml",
    "files": [
      {
        "kind": "Settings and controls",
        "class": "own",
        "path": "settings"
      },
      {
        "kind": "Gamelists, with play counts and favourites",
        "class": "own",
        "path": "gamelists"
      },
      {
        "kind": "Collections",
        "class": "own",
        "path": "collections"
      },
      {
        "kind": "Scraped pictures and videos",
        "class": "local",
        "path": "downloaded_media",
        "key": "MediaDirectory"
      },
      {
        "kind": "Themes",
        "class": "local",
        "path": "themes",
        "key": "UserThemeDirectory"
      },
      {
        "kind": "Logs",
        "class": "local",
        "path": "logs"
      }
    ],
    "manages": [
      {
        "key": "ApplicationUpdaterFrequency",
        "value": "never",
        "why": "The installer on the drive is the version every Mac has."
      }
    ],
    "notes": [
      "It finds Ryujinx and xemu only in /Applications."
    ],
    "feed": {
      "url": "https://updates.es-de.org/latest_release.json",
      "path": "stable.version"
    }
  },
  "systems": {
    "nes": {
      "emulator": "Mesen 2",
      "why": "The most accurate NES emulator, native on macOS.",
      "saves": "name",
      "settings": "~/Library/Application Support/Mesen2",
      "launch": {
        "app": "Mesen.app",
        "args": [
          "{file}"
        ]
      },
      "needs": []
    },
    "snes": {
      "emulator": "Mesen 2",
      "why": "The most accurate SNES emulator, native on macOS.",
      "saves": "name",
      "settings": "~/Library/Application Support/Mesen2",
      "launch": {
        "app": "Mesen.app",
        "args": [
          "{file}"
        ]
      },
      "needs": []
    },
    "n64": {
      "emulator": "ares",
      "why": "Accurate, and native on macOS.",
      "saves": "name",
      "settings": "~/Library/Application Support/ares",
      "launch": {
        "app": "ares.app",
        "args": [
          "--fullscreen",
          "--system",
          "Nintendo 64",
          "{file}"
        ]
      },
      "needs": []
    },
    "gb": {
      "emulator": "mGBA",
      "why": "Accurate and light, and it saves as plain .sav files.",
      "saves": "name",
      "settings": "~/.config/mgba",
      "launch": {
        "app": "mGBA.app",
        "args": [
          "-f",
          "{file}"
        ]
      },
      "needs": []
    },
    "gbc": {
      "emulator": "mGBA",
      "why": "Accurate and light, and it saves as plain .sav files.",
      "saves": "name",
      "settings": "~/.config/mgba",
      "launch": {
        "app": "mGBA.app",
        "args": [
          "-f",
          "{file}"
        ]
      },
      "needs": []
    },
    "gba": {
      "emulator": "mGBA",
      "why": "Accurate and light, and it saves as plain .sav files.",
      "saves": "name",
      "settings": "~/.config/mgba",
      "launch": {
        "app": "mGBA.app",
        "args": [
          "-f",
          "{file}"
        ]
      },
      "needs": [
        {
          "file": "gba_bios.bin",
          "sha1": "300c20df6731a33952ded8c436f7f186d25d3492",
          "optional": true
        }
      ]
    },
    "nds": {
      "emulator": "melonDS",
      "why": "The most accurate DS emulator, native on macOS.",
      "saves": "name",
      "settings": "~/Library/Preferences/melonDS",
      "launch": {
        "app": "melonDS.app",
        "args": [
          "-f",
          "{file}"
        ]
      },
      "needs": [
        {
          "file": "bios7.bin",
          "sha1": "24f67bdea115a2c847c8813a262502ee1607b7df",
          "optional": true
        },
        {
          "file": "bios9.bin",
          "sha1": "bfaac75f101c135e32e2aaf541de6b1be4c8c62d",
          "optional": true
        },
        {
          "file": "firmware.bin",
          "optional": true
        }
      ]
    },
    "n3ds": {
      "emulator": "Azahar",
      "why": "The maintained successor to Citra; it plays a decrypted .3ds as it is.",
      "saves": "titleId",
      "settings": "~/Library/Application Support/Azahar",
      "launch": {
        "app": "Azahar.app",
        "args": [
          "{file}"
        ]
      },
      "needs": []
    },
    "psx": {
      "emulator": "DuckStation",
      "why": "The most accurate and fastest PS1 emulator; it reads CHD and .m3u and keeps one memory card per game.",
      "saves": "serial",
      "settings": "~/Library/Application Support/DuckStation",
      "launch": {
        "app": "DuckStation.app",
        "args": [
          "-batch",
          "{file}"
        ]
      },
      "needs": [
        {
          "file": "scph5501.bin",
          "sha1": "0555c6fae8906f3f09baf5988f00e55f88e9f30b",
          "label": "PS1 BIOS for USA games"
        }
      ]
    },
    "ps2": {
      "emulator": "PCSX2",
      "why": "The only mature PS2 emulator; its Mac build runs under Rosetta, and only unofficial forks are native.",
      "saves": "serial",
      "settings": "~/Library/Application Support/PCSX2",
      "launch": {
        "app": "PCSX2.app",
        "args": [
          "-batch",
          "{file}"
        ]
      },
      "needs": [
        {
          "pattern": "^scph\\d+\\.bin$",
          "label": "a PS2 BIOS"
        }
      ]
    },
    "gc": {
      "emulator": "Dolphin",
      "why": "The only mature GameCube emulator; it reads RVZ.",
      "saves": "discId",
      "settings": "~/Library/Application Support/Dolphin",
      "launch": {
        "app": "Dolphin.app",
        "args": [
          "-b",
          "-e",
          "{file}"
        ]
      },
      "needs": []
    },
    "wii": {
      "emulator": "Dolphin",
      "why": "The only mature Wii emulator; it reads RVZ.",
      "saves": "discId",
      "settings": "~/Library/Application Support/Dolphin",
      "launch": {
        "app": "Dolphin.app",
        "args": [
          "-b",
          "-e",
          "{file}"
        ]
      },
      "needs": []
    },
    "wiiu": {
      "emulator": "Cemu",
      "why": "The only mature Wii U emulator; its automatic builds are native on Apple Silicon, where the 2.6 release runs under Rosetta. A .wua needs no keys.",
      "saves": "titleId",
      "settings": "~/Library/Application Support/Cemu",
      "launch": {
        "app": "Cemu.app",
        "args": [
          "-g",
          "{file}"
        ]
      },
      "needs": []
    },
    "switch": {
      "emulator": "Ryujinx",
      "why": "The Switch emulator with a supported Apple Silicon build, from ryujinx.app; Eden calls its Mac build experimental.",
      "saves": "titleId",
      "savesIn": "^Ryujinx/bis/user/save/",
      "settings": "~/Library/Application Support/Ryujinx",
      "launch": {
        "app": "Ryujinx.app",
        "args": [
          "{file}"
        ]
      },
      "needs": [
        {
          "file": "prod.keys",
          "secret": true
        },
        {
          "file": "title.keys",
          "secret": true
        },
        {
          "pattern": "^firmware.*\\.zip$",
          "label": "firmware"
        }
      ]
    },
    "xbox": {
      "emulator": "xemu",
      "why": "The only mature Xbox emulator.",
      "saves": "titleId",
      "settings": "~/Library/Application Support/xemu",
      "launch": {
        "app": "xemu.app",
        "args": [
          "-dvd_path",
          "{file}"
        ]
      },
      "needs": [
        {
          "file": "mcpx_1.0.bin",
          "label": "MCPX boot ROM"
        },
        {
          "pattern": "^complex_4627.*\\.bin$",
          "label": "flash BIOS"
        }
      ]
    }
  },
  "macSaves": {
    "Mesen 2": {
      "apps": [
        "Mesen.app",
        "Mesen2.app"
      ],
      "homes": [
        "~/Library/Application Support/Mesen2",
        "~/.config/Mesen2"
      ],
      "config": {
        "file": "settings.json",
        "format": "json"
      },
      "places": [
        {
          "path": "Saves",
          "key": "Preferences.SaveDataFolder",
          "kind": "Saves",
          "stored": "saves/nes"
        },
        {
          "path": "SaveStates",
          "key": "Preferences.SaveStateFolder",
          "kind": "Save states",
          "stored": "saves/nes/states"
        }
      ],
      "reportsVersion": false,
      "files": [
        {
          "kind": "Screenshots",
          "class": "collected",
          "path": "Screenshots",
          "key": "Preferences.ScreenshotFolder"
        },
        {
          "kind": "Settings and controls",
          "class": "own",
          "path": "settings.json"
        },
        {
          "kind": "Per-game settings",
          "class": "own",
          "path": "GameConfig"
        },
        {
          "kind": "Cheats",
          "class": "own",
          "path": "Cheats"
        },
        {
          "kind": "Firmware",
          "class": "provided",
          "path": "Firmware"
        },
        {
          "kind": "Recent games",
          "class": "local",
          "path": "RecentGames"
        },
        {
          "kind": "Movies and recordings",
          "class": "local",
          "path": "Movies, Avi, Wave"
        }
      ],
      "manages": [
        {
          "key": "Preferences.OverrideSaveDataFolder",
          "value": "false",
          "why": "Saves sit in its own folder on the Mac, where Emu carries them to and from Supabase."
        },
        {
          "key": "Preferences.SaveDataFolder",
          "value": "",
          "why": "With no folder named, Mesen 2 saves in its own."
        },
        {
          "key": "Preferences.OverrideSaveStateFolder",
          "value": "false",
          "why": "Save states sit in its own folder too, and are carried the same way."
        },
        {
          "key": "Preferences.SaveStateFolder",
          "value": "",
          "why": "With no folder named, its save states stay in its own."
        },
        {
          "key": "Preferences.AutomaticallyCheckForUpdates",
          "value": "false",
          "why": "The installer on the drive is the version every Mac has."
        }
      ],
      "notes": [
        "It writes a save only when the game stops or another one loads.",
        "It makes a save state every five minutes, as slot 11.",
        "A folder setting counts only with its Override setting on, and with that folder missing it saves in its own without saying so.",
        "The app says version 1.0 whatever its version is."
      ],
      "feed": {
        "github": "SourMesen/Mesen2"
      }
    },
    "mGBA": {
      "apps": [
        "mGBA.app"
      ],
      "homes": [
        "~/.config/mgba"
      ],
      "config": {
        "file": "config.ini",
        "format": "ini"
      },
      "besideGame": true,
      "places": [
        {
          "path": "saves",
          "key": "ports.qt/savegamePath",
          "kind": "Saves",
          "stored": "saves/gb"
        },
        {
          "path": "states",
          "key": "ports.qt/savestatePath",
          "kind": "Save states",
          "stored": "saves/gb/states"
        }
      ],
      "files": [
        {
          "kind": "Screenshots",
          "class": "collected",
          "besideGame": true,
          "key": "ports.qt/screenshotPath"
        },
        {
          "kind": "Cheats",
          "class": "own",
          "besideGame": true,
          "key": "ports.qt/cheatsPath"
        },
        {
          "kind": "Settings and controls",
          "class": "own",
          "path": "config.ini, qt.ini"
        },
        {
          "kind": "Its list of games",
          "class": "local",
          "path": "library.sqlite3"
        }
      ],
      "manages": [
        {
          "key": "ports.qt/savegamePath",
          "value": "{home}/saves",
          "why": "Saves sit in mGBA's own folder on the Mac, where Emu carries them to and from Supabase."
        },
        {
          "key": "ports.qt/savestatePath",
          "value": "{home}/states",
          "why": "Save states sit beside the saves and are carried the same way."
        },
        {
          "key": "ports.qt/updateAutoCheck",
          "value": "0",
          "why": "The installer on the drive is the version every Mac has."
        }
      ],
      "notes": [
        "Saves, save states, screenshots and cheats sit beside the game unless each has a folder set.",
        "It writes a save a moment after the game does."
      ],
      "feed": {
        "github": "mgba-emu/mgba"
      }
    },
    "ares": {
      "apps": [
        "ares.app"
      ],
      "homes": [
        "~/Library/Application Support/ares"
      ],
      "config": {
        "file": "settings.bml",
        "format": "bml"
      },
      "besideGame": true,
      "places": [
        {
          "path": "Saves",
          "key": "Paths/Saves",
          "kind": "Saves and save states",
          "stored": "saves/n64"
        }
      ],
      "files": [
        {
          "kind": "Screenshots",
          "class": "collected",
          "besideGame": true,
          "key": "Paths/Screenshots"
        },
        {
          "kind": "Settings and controls",
          "class": "own",
          "path": "settings.bml"
        },
        {
          "kind": "Debugging logs",
          "class": "local",
          "besideGame": true,
          "key": "Paths/Debugging"
        }
      ],
      "manages": [
        {
          "key": "Paths/Saves",
          "value": "{home}/Saves/",
          "why": "Saves sit in its own folder on the Mac, where Emu carries them to and from Supabase."
        },
        {
          "key": "General/AutoSaveMemory",
          "value": "true",
          "why": "A save is written every 30 seconds, not only when the game closes."
        }
      ],
      "notes": [
        "It adds the system's name to its saves folder, as Nintendo 64/, and a folder setting must end in a slash.",
        "Saves and save states sit beside the game unless a folder is set."
      ],
      "feed": {
        "github": "ares-emulator/ares"
      }
    },
    "melonDS": {
      "apps": [
        "melonDS.app"
      ],
      "homes": [
        "~/Library/Preferences/melonDS"
      ],
      "config": {
        "file": "melonDS.toml",
        "format": "toml"
      },
      "besideGame": true,
      "places": [
        {
          "path": "saves",
          "key": "SaveFilePath",
          "kind": "Saves",
          "stored": "saves/nds"
        },
        {
          "path": "states",
          "key": "SavestatePath",
          "kind": "Save states",
          "stored": "saves/nds/states"
        }
      ],
      "files": [
        {
          "kind": "Cheats",
          "class": "own",
          "besideGame": true,
          "key": "CheatFilePath"
        },
        {
          "kind": "Settings and controls",
          "class": "own",
          "path": "melonDS.toml"
        },
        {
          "kind": "Wi-Fi and console settings",
          "class": "own",
          "path": "wfcsettings.bin"
        },
        {
          "kind": "BIOS and firmware",
          "class": "provided",
          "key": "DS.BIOS9Path, DS.BIOS7Path, DS.FirmwarePath"
        }
      ],
      "manages": [
        {
          "key": "SaveFilePath",
          "value": "{home}/saves",
          "why": "Saves sit in its own folder on the Mac, where Emu carries them to and from Supabase."
        },
        {
          "key": "SavestatePath",
          "value": "{home}/states",
          "why": "Save states sit in its own folder too, and are carried the same way."
        }
      ],
      "notes": [
        "Saves, save states and cheats sit beside the game unless each has a folder set.",
        "It writes a save two seconds after the game does.",
        "With its own BIOS on, it writes this Mac's console settings into the firmware file."
      ],
      "feed": {
        "github": "melonDS-emu/melonDS"
      }
    },
    "Azahar": {
      "apps": [
        "Azahar.app"
      ],
      "homes": [
        "~/Library/Application Support/Azahar"
      ],
      "config": {
        "file": "config/qt-config.ini",
        "format": "ini"
      },
      "places": [
        {
          "path": "sdmc",
          "key": "Data%20Storage/sdmc_directory",
          "include": "/(title/[0-9a-f]{8}/[0-9a-f]{8}/data|extdata)/",
          "whole": "^(saves/n3ds/sdmc/.*?/(?:title/[0-9a-f]{8}/[0-9a-f]{8}/data|extdata/[0-9a-f]{8}/[0-9a-f]{8}))/",
          "kind": "Game saves and extra data, on its SD card",
          "stored": "saves/n3ds/sdmc"
        },
        {
          "path": "nand",
          "key": "Data%20Storage/nand_directory",
          "include": "/(title/[0-9a-f]{8}/[0-9a-f]{8}/data|extdata)/",
          "whole": "^(saves/n3ds/nand/.*?/(?:title/[0-9a-f]{8}/[0-9a-f]{8}/data|extdata/[0-9a-f]{8}/[0-9a-f]{8}))/",
          "kind": "System saves, in its console storage",
          "stored": "saves/n3ds/nand"
        },
        {
          "path": "states",
          "kind": "Save states",
          "stored": "saves/n3ds/states"
        }
      ],
      "files": [
        {
          "kind": "Keys and console files",
          "class": "provided",
          "path": "sysdata"
        },
        {
          "kind": "Settings and controls",
          "class": "own",
          "path": "config/qt-config.ini"
        },
        {
          "kind": "Per-game settings",
          "class": "own",
          "path": "config/custom"
        },
        {
          "kind": "Cheats",
          "class": "own",
          "path": "cheats"
        },
        {
          "kind": "Screenshots",
          "class": "collected",
          "path": "screenshots",
          "key": "screenshotPath"
        },
        {
          "kind": "Mods and textures",
          "class": "local",
          "path": "load"
        },
        {
          "kind": "Shader cache",
          "class": "local",
          "path": "shaders"
        },
        {
          "kind": "Its log",
          "class": "local",
          "path": "log"
        }
      ],
      "manages": [
        {
          "key": "Data%20Storage/sdmc_directory",
          "value": "{home}/sdmc/",
          "why": "Its SD card sits in its own folder on the Mac, where Emu carries each game's saves to and from Supabase."
        },
        {
          "key": "Data%20Storage/nand_directory",
          "value": "{home}/nand/",
          "why": "Its console storage sits in its own folder too."
        },
        {
          "key": "Miscellaneous/check_for_update_on_start\\default",
          "value": "false",
          "why": "Azahar reads a setting only when its default mark is off."
        },
        {
          "key": "Miscellaneous/check_for_update_on_start",
          "value": "false",
          "why": "The installer on the drive is the version every Mac has."
        }
      ],
      "notes": [
        "Opened with a storage folder missing, it puts its own back into its settings and saves there from then on.",
        "Its SD card and console storage folders count only with use_custom_storage on.",
        "It writes a save as the game does."
      ],
      "feed": {
        "github": "azahar-emu/azahar"
      }
    },
    "DuckStation": {
      "apps": [
        "DuckStation.app"
      ],
      "homes": [
        "~/Library/Application Support/DuckStation"
      ],
      "config": {
        "file": "settings.ini",
        "format": "ini"
      },
      "places": [
        {
          "path": "memcards",
          "key": "MemoryCards/Directory",
          "kind": "Memory cards",
          "stored": "saves/psx"
        },
        {
          "path": "savestates",
          "key": "Folders/SaveStates",
          "kind": "Save states",
          "stored": "saves/psx/states"
        }
      ],
      "files": [
        {
          "kind": "BIOS",
          "class": "provided",
          "path": "bios",
          "key": "BIOS/SearchDirectory",
          "given": "bios/psx"
        },
        {
          "kind": "Settings and controls",
          "class": "own",
          "path": "settings.ini"
        },
        {
          "kind": "Per-game settings",
          "class": "own",
          "path": "gamesettings",
          "key": "Folders/GameSettings"
        },
        {
          "kind": "Controller profiles",
          "class": "own",
          "path": "inputprofiles",
          "key": "Folders/InputProfiles"
        },
        {
          "kind": "Cheats and patches",
          "class": "own",
          "path": "cheats, patches",
          "key": "Folders/Cheats, Folders/Patches"
        },
        {
          "kind": "Screenshots",
          "class": "collected",
          "path": "screenshots",
          "key": "Folders/Screenshots"
        },
        {
          "kind": "Covers",
          "class": "local",
          "path": "covers",
          "key": "Folders/Covers"
        },
        {
          "kind": "Cache",
          "class": "local",
          "path": "cache",
          "key": "Folders/Cache"
        },
        {
          "kind": "Play time",
          "class": "local",
          "path": "playtime.dat"
        }
      ],
      "manages": [
        {
          "key": "BIOS/SearchDirectory",
          "value": "{home}/bios",
          "why": "Its BIOS sits in its own folder on the Mac, brought from Supabase, so it starts with no drive plugged in."
        },
        {
          "key": "MemoryCards/Directory",
          "value": "{home}/memcards",
          "why": "Memory cards sit in its own folder on the Mac, where Emu carries them to and from Supabase."
        },
        {
          "key": "Folders/SaveStates",
          "value": "{home}/savestates",
          "why": "Save states sit in its own folder too, and are carried the same way."
        },
        {
          "key": "MemoryCards/Card1Type",
          "value": "PerGame",
          "why": "One card per game, named by the disc's serial, so every Mac names a card alike."
        },
        {
          "key": "AutoUpdater/CheckAtStartup",
          "value": "false",
          "why": "The installer on the drive is the version every Mac has."
        }
      ],
      "notes": [
        "It writes a memory card five seconds after the game does.",
        "It has no numbered releases, only the newest build, counted from 0.1."
      ],
      "feed": {
        "github": "stenzek/duckstation",
        "count": [
          "0.1",
          "latest"
        ],
        "rolling": true
      }
    },
    "PCSX2": {
      "apps": [
        "PCSX2.app"
      ],
      "homes": [
        "~/Library/Application Support/PCSX2"
      ],
      "config": {
        "file": "inis/PCSX2.ini",
