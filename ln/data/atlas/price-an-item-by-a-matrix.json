  "before": [],
  "why": {
    "tokens": [
      {
        "t": "text",
        "v": "A price book holds prices by item. A matrix definition names the attributes a price is chosen by, such as Sold-to BP and Product Class, and its priority says which definition LN tries first. A sales price matrix then links a combination of those attributes to a price book. On the order line, LN finds the first matrix that matches and takes its price book's price."
      }
    ],
