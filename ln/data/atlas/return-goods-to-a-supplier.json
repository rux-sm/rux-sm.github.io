  "why": {
    "tokens": [
      {
        "t": "text",
        "v": "A purchase return is a purchase order of a return order type, with negative quantities. It names the order it reverses and a reason. Approving it hands the line to warehousing, which takes the goods out of stock, and the negative receipt is what the supplier's credit is matched to."
      }
    ],
