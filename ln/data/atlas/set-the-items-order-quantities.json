  "before": [],
  "why": {
    "tokens": [
      {
        "t": "text",
        "v": "Planning first works out how much is short. Then it shapes that number with the item's ordering rules: a minimum raises a small order, a maximum splits a large one, and an increment rounds it up to a multiple. The rules are kept for the item and again for each site, and the site uses the item's only while it is set to follow them."
      }
    ],
