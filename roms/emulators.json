{
  "frontend": {
    "name": "ES-DE",
    "why": "It launches each system's emulator from one list of every game, and reads the drive's roms folders as they are named.",
    "settings": "~/ES-DE",
    "apps": [
      "ES-DE.app"
    ],
    "config": "settings/es_settings.xml"
  },
  "systems": {
    "nes": {
      "emulator": "Mesen 2",
      "why": "The most accurate NES emulator, native on macOS.",
      "saves": "name",
      "settings": "~/Library/Application Support/Mesen2",
      "needs": []
    },
    "snes": {
      "emulator": "Mesen 2",
      "why": "The most accurate SNES emulator, native on macOS.",
      "saves": "name",
      "settings": "~/Library/Application Support/Mesen2",
      "needs": []
    },
    "n64": {
      "emulator": "ares",
      "why": "Accurate, and native on macOS.",
      "saves": "name",
      "settings": "~/Library/Application Support/ares",
      "needs": []
    },
    "gb": {
      "emulator": "mGBA",
      "why": "Accurate and light, and it saves as plain .sav files.",
      "saves": "name",
      "settings": "~/Library/Application Support/mGBA",
      "needs": []
    },
    "gbc": {
      "emulator": "mGBA",
      "why": "Accurate and light, and it saves as plain .sav files.",
      "saves": "name",
      "settings": "~/Library/Application Support/mGBA",
      "needs": []
    },
    "gba": {
      "emulator": "mGBA",
      "why": "Accurate and light, and it saves as plain .sav files.",
      "saves": "name",
      "settings": "~/Library/Application Support/mGBA",
      "needs": [
        {
          "file": "gba_bios.bin",
          "md5": "a860e8c0b6d573d191e4ec7db1b1e4f6",
          "optional": true
        }
      ]
    },
    "nds": {
      "emulator": "melonDS",
      "why": "The most accurate DS emulator, native on macOS.",
      "saves": "name",
      "settings": "~/Library/Preferences/melonDS",
      "needs": [
        {
          "file": "bios7.bin",
          "md5": "df692a80a5b1bc90728bc3dfc76cd948",
          "optional": true
        },
        {
          "file": "bios9.bin",
          "md5": "a392174eb3e572fed6447e956bde4b25",
          "optional": true
        },
        {
          "file": "firmware.bin",
          "optional": true
        }
      ]
    },
    "n3ds": {
      "emulator": "Azahar",
      "why": "The maintained successor to Citra; it plays a decrypted .3ds as it is.",
      "saves": "titleId",
      "settings": "~/Library/Application Support/Azahar",
      "needs": []
    },
    "psx": {
      "emulator": "DuckStation",
      "why": "The most accurate and fastest PS1 emulator; it reads CHD and .m3u and keeps one memory card per game.",
      "saves": "serial",
      "settings": "~/Library/Application Support/DuckStation",
      "needs": [
        {
          "file": "scph5501.bin",
          "md5": "490f666e1afb15b7362b406ed1cea246",
          "label": "PS1 BIOS for USA games"
        }
      ]
    },
    "ps2": {
      "emulator": "PCSX2",
      "why": "The only mature PS2 emulator; its Mac build runs under Rosetta, and only unofficial forks are native.",
      "saves": "serial",
      "settings": "~/Library/Application Support/PCSX2",
      "needs": [
        {
          "pattern": "^scph\\d+\\.bin$",
          "label": "a PS2 BIOS"
        }
      ]
    },
    "gc": {
      "emulator": "Dolphin",
      "why": "The only mature GameCube emulator; it reads RVZ.",
      "saves": "discId",
      "settings": "~/Library/Application Support/Dolphin",
      "needs": []
    },
    "wii": {
      "emulator": "Dolphin",
      "why": "The only mature Wii emulator; it reads RVZ.",
      "saves": "discId",
      "settings": "~/Library/Application Support/Dolphin",
      "needs": []
    },
    "wiiu": {
      "emulator": "Cemu",
      "why": "The only mature Wii U emulator; its automatic builds are native on Apple Silicon, where the 2.6 release runs under Rosetta. A .wua needs no keys.",
      "saves": "titleId",
      "settings": "~/Library/Application Support/Cemu",
      "needs": []
    },
    "switch": {
      "emulator": "Ryujinx",
      "why": "The Switch emulator with a supported Apple Silicon build, from ryujinx.app; Eden calls its Mac build experimental.",
      "saves": "titleId",
      "settings": "~/Library/Application Support/Ryujinx",
      "needs": [
        {
          "file": "prod.keys",
          "secret": true
        },
        {
          "file": "title.keys",
          "secret": true
        },
        {
          "pattern": "^firmware.*\\.zip$",
          "label": "firmware"
        }
      ]
    },
    "xbox": {
      "emulator": "xemu",
      "why": "The only mature Xbox emulator, for when Xbox games join.",
      "saves": "titleId",
      "settings": "~/Library/Application Support/xemu",
      "needs": [
        {
          "file": "mcpx_1.0.bin",
          "label": "MCPX boot ROM"
        },
        {
          "pattern": "^complex_4627.*\\.bin$",
          "label": "flash BIOS"
        },
        {
          "file": "xbox_hdd.qcow2",
          "label": "hard disk image"
        }
      ]
    }
  },
  "macSaves": {
    "Mesen 2": {
      "apps": [
        "Mesen.app",
        "Mesen2.app"
      ],
      "homes": [
        "~/Library/Application Support/Mesen2",
        "~/.config/Mesen2"
      ],
      "config": {
        "file": "settings.json",
        "format": "json"
      },
      "places": [
        {
          "path": "Saves",
          "key": "Preferences.SaveDataFolder"
        },
        {
          "path": "SaveStates"
        }
      ]
    },
    "mGBA": {
      "apps": [
        "mGBA.app"
      ],
      "homes": [
        "~/Library/Application Support/mGBA"
      ],
      "config": {
        "file": "config.ini",
        "format": "ini"
      },
      "besideGame": true,
      "places": [
        {
          "key": "ports.qt/savegamePath"
        },
        {
          "key": "ports.qt/savestatePath"
        }
      ]
    },
    "ares": {
      "apps": [
        "ares.app"
      ],
      "homes": [
        "~/Library/Application Support/ares"
      ],
      "config": {
        "file": "settings.bml",
        "format": "bml"
      },
      "besideGame": true,
      "places": [
        {
          "path": "Saves",
          "key": "Paths/Saves"
        }
      ]
    },
    "melonDS": {
      "apps": [
        "melonDS.app"
      ],
      "homes": [
        "~/Library/Preferences/melonDS"
      ],
      "config": {
        "file": "melonDS.toml",
        "format": "toml"
      },
      "besideGame": true,
      "places": [
        {
          "key": "SaveFilePath"
        }
      ]
    },
    "Azahar": {
      "apps": [
        "Azahar.app"
      ],
      "homes": [
        "~/Library/Application Support/Azahar"
      ],
      "config": {
        "file": "config/qt-config.ini",
        "format": "ini"
      },
      "places": [
        {
          "path": "sdmc",
          "key": "Data%20Storage/sdmc_directory",
          "include": "/(title/[0-9a-f]{8}/[0-9a-f]{8}/data|extdata)/"
        },
        {
          "path": "nand",
          "key": "Data%20Storage/nand_directory",
          "include": "/(title/[0-9a-f]{8}/[0-9a-f]{8}/data|extdata)/"
        }
      ]
    },
    "DuckStation": {
      "apps": [
        "DuckStation.app"
      ],
      "homes": [
        "~/Library/Application Support/DuckStation"
      ],
      "config": {
        "file": "settings.ini",
        "format": "ini"
      },
      "places": [
        {
          "path": "memcards",
          "key": "MemoryCards/Directory"
        },
        {
          "path": "savestates",
          "key": "Folders/SaveStates"
        }
      ]
    },
    "PCSX2": {
      "apps": [
        "PCSX2.app"
      ],
      "homes": [
        "~/Library/Application Support/PCSX2"
      ],
      "config": {
        "file": "inis/PCSX2.ini",
        "format": "ini"
      },
      "places": [
        {
          "path": "memcards",
          "key": "Folders/MemoryCards"
        },
        {
          "path": "sstates",
          "key": "Folders/Savestates"
        }
      ]
    },
    "Dolphin": {
      "apps": [
        "Dolphin.app"
      ],
      "homes": [
        "~/Library/Application Support/Dolphin"
      ],
      "config": {
        "file": "Config/Dolphin.ini",
        "format": "ini"
      },
      "places": [
        {
          "path": "GC",
          "key": "Core/GCIFolderAPath"
        },
        {
          "path": "Wii",
          "key": "General/NANDRootPath",
          "include": "^title/"
        },
        {
          "path": "StateSaves"
        }
      ]
    },
    "Cemu": {
      "apps": [
        "Cemu.app"
      ],
      "homes": [
        "~/Library/Application Support/Cemu"
      ],
      "config": {
        "file": "settings.xml",
        "format": "xml"
      },
      "places": [
        {
          "path": "mlc01",
          "key": "mlc_path",
          "include": "^usr/save/"
        }
      ]
    },
    "Ryujinx": {
      "apps": [
        "Ryujinx.app"
      ],
      "homes": [
        "~/Library/Application Support/Ryujinx"
      ],
      "places": [
        {
          "path": "bis/user/save"
        }
      ]
    },
    "xemu": {
      "apps": [
        "xemu.app"
      ],
      "homes": [
        "~/Library/Application Support/xemu/xemu"
      ],
      "places": [],
      "inHardDisk": true
    }
  },
  "retired": {
    "RetroArch": {
      "apps": [
        "RetroArch.app"
      ],
      "homes": [
        "~/Library/Application Support/RetroArch"
      ],
      "config": {
        "file": "config/retroarch.cfg",
        "format": "toml"
      },
      "places": [
        {
          "path": "saves",
          "key": "savefile_directory"
        },
        {
          "path": "states",
          "key": "savestate_directory"
        }
      ]
    },
    "Citra": {
      "apps": [
        "Citra.app",
        "citra-qt.app"
      ],
      "homes": [
        "~/Library/Application Support/Citra"
      ],
      "places": [
        {
          "path": "sdmc"
        }
      ]
    },
    "OpenEmu": {
      "apps": [
        "OpenEmu.app"
      ],
      "homes": [
        "~/Library/Application Support/OpenEmu"
      ],
      "places": [
        {
          "path": "Battery Saves"
        },
        {
          "path": "Save States"
        }
      ]
    }
  }
}
