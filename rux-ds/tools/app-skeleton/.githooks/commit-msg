#!/bin/sh
# rux-ds's commit-message hook, run from the checkout beside this repository
# (or DS=<dir>). Arm once per clone:
#   git config core.hooksPath .githooks
DS="${DS:-$(dirname "$0")/../../rux-ds}"
if [ ! -f "$DS/.githooks/commit-msg" ]; then
  echo "commit-msg: no rux-ds at $DS -- clone it beside this repository, or set DS=<dir>" >&2
  exit 1
fi
exec bash "$DS/.githooks/commit-msg" "$@"
